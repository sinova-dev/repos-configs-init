{
  "name": "@sinova-development/repos-configs",
  "version": "0.0.2",
  "description": "Sinova Development repos configs",
  "type": "module",
  "exports": {
    "./prettier-config": "./prettier-config.js",
    "./eslint-config": "./eslint-config.mjs"
  },
  "license": "MIT",
  "scripts": {
    "format": "prettier . --write --log-level=warn",
    "format:check": "prettier . --check --log-level=warn",
    "pre-commit": "pnpm install && git add pnpm-lock.yaml && pnpm lint-staged --allow-empty",
    "prepare": "husky || true"
  },
  "bin": {
    "sinova-general-config-init": "./init.mjs",
    "sinova-eslint-init": "./eslint-init.mjs",
    "sinova-husky-init": "./husky-init.mjs",
    "sinova-prettier-init": "./prettier-init.mjs"
  },
  "dependencies": {
    "inquirer": "^9.0.0",
    "lodash.merge": "^4.6.2"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.1",
    "husky": "^9.1.7",
    "prettier": ">=3.0.0",
    "prettier-plugin-tailwindcss": ">=0.6.10",
    "release-it": "^19.0.4"
  },
  "peerDependencies": {
    "husky": ">=9.1.7",
    "lint-staged": ">=15.0.0",
    "prettier": ">=3.0.0",
    "prettier-plugin-tailwindcss": ">=0.6.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "release-it": {
    "git": {
      "tagName": "v${version}",
      "commitMessage": "release: v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits"
      }
    }
  }
}
